#!/usr/bin/env bash

set -euo pipefail

# Exit codes:
#   0    OpenCode finished and no permission was auto-rejected
#   2    usage error, not inside a git repository, or a requested model that
#        OpenCode does not offer
#   3    OpenCode finished but a permission was denied or auto-rejected
#   4    a read-only run (OPENCODE_WORKER_MODE=read) changed the working tree
#   5    a file changed inside a directory shared read-only through
#        OPENCODE_WORKER_READ_DIRS
#   124  OpenCode timed out; changes may be partial
#   127  opencode not found
#   other  OpenCode's own exit code

usage() {
    echo "Usage: claude-opencode-worker <task>" >&2
    echo "       claude-opencode-worker <<'TASK' ... TASK" >&2
}

# Prefer stdin so callers can pass the task through a quoted heredoc and avoid
# shell expansion of $, backticks and quotes inside the task text.
if [[ $# -gt 0 ]]; then
    TASK="$*"
elif [[ ! -t 0 ]]; then
    TASK="$(cat)"
else
    usage
    exit 2
fi

if [[ -z "${TASK//[[:space:]]/}" ]]; then
    usage
    exit 2
fi

PROJECT_DIR="$(pwd)"
# Default stays below the 600s maximum of Claude Code's Bash tool, so the
# worker reports its own timeout instead of being killed silently. Raise it
# only when the caller runs the worker in the background.
TIMEOUT="${OPENCODE_WORKER_TIMEOUT:-570}"

if ! command -v opencode >/dev/null 2>&1; then
    echo "ERROR: opencode was not found in PATH." >&2
    exit 127
fi

# Without git there is no diff, and reviewing the diff is the point of
# delegating. Refuse instead of letting the changes go unreviewed.
if ! git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "ERROR: $PROJECT_DIR is not inside a git repository; run the worker from the repository that will be changed." >&2
    exit 2
fi

# Snapshot the working tree before the run so the report shows only what the
# worker changed, not changes the user already had. `git stash create` writes
# a commit object without touching the working tree or the stash list.
BASELINE=""
if git -C "$PROJECT_DIR" rev-parse --verify -q HEAD >/dev/null; then
    BASELINE="$(git -C "$PROJECT_DIR" stash create 2>/dev/null || true)"
    BASELINE="${BASELINE:-$(git -C "$PROJECT_DIR" rev-parse HEAD)}"
fi
# Untracked files are not in the snapshot, so hash them to also catch edits
# the worker makes to files that were already untracked.
hash_untracked() {
    local file
    git -C "$PROJECT_DIR" ls-files -z --others --exclude-standard \
        | while IFS= read -r -d '' file; do
            printf '%s %s\n' "$(git -C "$PROJECT_DIR" hash-object -- "$file" 2>/dev/null || echo unreadable)" "$file"
        done | LC_ALL=C sort
}

indent() {
    sed 's/^/  /'
}
UNTRACKED_BEFORE="$(hash_untracked)"
PREEXISTING="$(git -C "$PROJECT_DIR" status --porcelain)"

# Enforced by OpenCode itself, and only for delegated runs. Patterns start with
# "*" because command-rewriting plugins (e.g. rtk) turn "git commit" into
# "rtk git commit" before permissions are evaluated.
DENY_PATTERNS=(
    "*git commit*"
    "*git push*"
    "*git reset*"
    "*git clean*"
    "*git checkout*"
    "*git switch*"
    "*git restore*"
    "*git stash*"
    "*git rebase*"
    "*git merge*"
    "*rm -rf*"
    "*rm -fr*"
)

# Extra project- or user-specific rules (e.g. "*supabase db reset*"), one
# shell glob per line; blank lines and lines starting with # are ignored.
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude-opencode-worker"
DENY_FILE="${OPENCODE_WORKER_DENY_FILE:-$CONFIG_DIR/deny}"
if [[ -f "$DENY_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == \#* ]] && continue
        DENY_PATTERNS+=("$line")
    done < "$DENY_FILE"
fi

json_escape() {
    local s="${1//\\/\\\\}"
    printf '%s' "${s//\"/\\\"}"
}

BASH_RULES=""
for pattern in "${DENY_PATTERNS[@]}"; do
    BASH_RULES+="${BASH_RULES:+,}
      \"$(json_escape "$pattern")\": \"deny\""
done

# Everything outside the project is denied except OpenCode's own scratch and
# truncated-output directories, which it allows by default and needs to read
# long command output.
EXTERNAL_RULES='
      "*": "deny",
      "/tmp/opencode/*": "allow",
      "'"$(json_escape "${XDG_DATA_HOME:-$HOME/.local/share}")"'/opencode/tool-output/*": "allow"'

# Directories outside the project that the task may read, so the caller can
# point at a file instead of pasting it into the task. Colon-separated
# absolute paths. Edits there are checked after the run (exit 5).
READ_DIRS=()
if [[ -n "${OPENCODE_WORKER_READ_DIRS:-}" ]]; then
    IFS=: read -r -a _dirs <<< "$OPENCODE_WORKER_READ_DIRS"
    for dir in "${_dirs[@]}"; do
        [[ -z "$dir" ]] && continue
        if [[ "$dir" != /* || ! -d "$dir" ]]; then
            echo "ERROR: OPENCODE_WORKER_READ_DIRS entry is not an existing absolute directory: $dir" >&2
            exit 2
        fi
        dir="${dir%/}"
        READ_DIRS+=("$dir")
        EXTERNAL_RULES+=',
      "'"$(json_escape "$dir")"'": "allow",
      "'"$(json_escape "$dir")"'/*": "allow"'
    done
fi

# shellcheck disable=SC2016
DEFAULT_CONFIG='{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {'"$EXTERNAL_RULES"'
    },
    "bash": {'"$BASH_RULES"'
    }
  }
}'

# Read-only runs use OpenCode's plan agent and keep bash to commands that only
# read. Bash stays enabled with an allowlist instead of being denied outright:
# without the bash tool, OpenCode's free tier rejects the request. An allowed
# command can still write through a redirect, so the tree is checked after the
# run as well.
MODE="${OPENCODE_WORKER_MODE:-edit}"
READ_ONLY_COMMANDS=(
    "git status" "git log" "git show" "git diff" "git blame" "git grep"
    "git ls-files" "ls" "cat" "head" "tail" "grep" "wc" "sort" "uniq"
)
case "$MODE" in
    edit)
        AGENT=build
        ;;
    read)
        AGENT=plan
        BASH_RULES='
      "*": "deny"'
        for cmd in "${READ_ONLY_COMMANDS[@]}"; do
            # rtk rewrites commands with an "rtk " prefix before permissions
            # are evaluated.
            BASH_RULES+=",
      \"$cmd\": \"allow\",
      \"$cmd *\": \"allow\",
      \"rtk $cmd\": \"allow\",
      \"rtk $cmd *\": \"allow\""
        done
        # shellcheck disable=SC2016
        DEFAULT_CONFIG='{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {'"$EXTERNAL_RULES"'
    },
    "edit": "deny",
    "bash": {'"$BASH_RULES"'
    }
  }
}'
        ;;
    *)
        echo "ERROR: OPENCODE_WORKER_MODE must be edit or read." >&2
        exit 2
        ;;
esac

if [[ -n "${OPENCODE_CONFIG_CONTENT:-}" ]]; then
    echo "WARNING: OPENCODE_CONFIG_CONTENT is already set; the worker's deny rules are not applied." >&2
else
    export OPENCODE_CONFIG_CONTENT="$DEFAULT_CONFIG"
fi

# Resuming the worker's own session lets a review send only the correction
# instead of restating the whole task. The session id is pinned rather than
# using --continue, which could pick up an unrelated interactive session.
SESSION="${OPENCODE_WORKER_SESSION:-}"
if [[ -n "$SESSION" && ! "$SESSION" =~ ^ses_[A-Za-z0-9]+$ ]]; then
    echo "ERROR: OPENCODE_WORKER_SESSION must be an OpenCode session id (ses_...)." >&2
    exit 2
fi
# Without an explicit model OpenCode uses its own default; the worker only
# passes one when the user asked for a specific model.
MODEL="${OPENCODE_WORKER_MODEL:-}"

# Free models come and go; fail before dispatching instead of mid-run.
if [[ -n "$MODEL" ]]; then
    if AVAILABLE_MODELS="$(opencode models 2>/dev/null)"; then
        if ! grep -Fxq -- "$MODEL" <<< "$AVAILABLE_MODELS"; then
            echo "ERROR: model $MODEL is not available in OpenCode (see 'opencode models')." >&2
            exit 2
        fi
    else
        echo "WARNING: could not list OpenCode models; $MODEL was not checked." >&2
    fi
fi

if [[ -n "$MODEL" ]]; then
    MODEL_LABEL="$MODEL"
elif [[ -n "$SESSION" ]]; then
    MODEL_LABEL="the resumed session's model"
else
    LAST_MODEL="$(python3 -c '
import json, os, sys
try:
    r = json.load(open(os.path.expanduser("~/.local/state/opencode/model.json")))["recent"][0]
    print(r["providerID"] + "/" + r["modelID"])
except Exception:
    pass
' 2>/dev/null || true)"
    MODEL_LABEL="OpenCode default (last used: ${LAST_MODEL:-unknown})"
fi

RUN_STAMP="$(date +%Y%m%dT%H%M%S)-$$-$RANDOM"
RUN_TITLE="claude-opencode-worker $RUN_STAMP"

READ_DIRS_NOTE=""
if [[ ${#READ_DIRS[@]} -gt 0 ]]; then
    READ_DIRS_NOTE="
You may read, but never edit, these directories outside the project: ${READ_DIRS[*]}
"
fi

if [[ "$MODE" == read ]]; then
    PROMPT="You are running as a delegated read-only analysis worker. Do not create, edit or delete any file, and do not run commands that change anything; file edits are denied and bash only allows commands that read. Answer the task with your findings, citing file paths and line numbers, and say plainly when you are not sure of something. Keep the answer as short as the task allows: it is read by another model that pays for every word.
${READ_DIRS_NOTE}
${SESSION:+Follow-up question on the analysis you already did in this session:
}Task:
$TASK"
else
    PROMPT="You are running as a delegated implementation worker. Leave all changes uncommitted for review. Do not run git commands that commit, push, reset, clean, checkout, switch, restore, stash, rebase or merge; they are denied. Do not edit files outside $PROJECT_DIR. Do not delete directories recursively; that is denied too, as are any extra commands the user configured. Do only what the task asks, keep the code as short as the task allows, and end with a short summary of what you changed and how you checked it.
${READ_DIRS_NOTE}
${SESSION:+Follow-up on the task you already worked on in this session. Apply only this change and keep the rest of your earlier work:
}Task:
$TASK"
fi

# The caller pays for every line printed here, so the report stays short:
# OpenCode's own transcript goes to a log file, not to stdout.
echo "=== OpenCode Worker === Mode: $MODE | Model: $MODEL_LABEL | Timeout: ${TIMEOUT}s"
if [[ -n "$SESSION" ]]; then
    echo "Resuming session: $SESSION"
fi
if [[ -n "$PREEXISTING" ]]; then
    echo "Pre-existing changes (not the worker's):"
    head -n 15 <<< "$PREEXISTING" | indent
    PRE_COUNT="$(wc -l <<< "$PREEXISTING")"
    [[ $PRE_COUNT -gt 15 ]] && echo "  ... and $((PRE_COUNT - 15)) more"
fi

ARGS=(
    run
    --dir "$PROJECT_DIR"
    --agent "$AGENT"
    --format json
)

if [[ -n "$MODEL" ]]; then
    ARGS+=(--model "$MODEL")
fi

if [[ -n "$SESSION" ]]; then
    ARGS+=(--session "$SESSION")
else
    ARGS+=(--title "$RUN_TITLE")
fi

# Full transcript (JSON events) and stderr are kept for a week, for the rare
# review that needs more than the summary.
LOG_DIR="${OPENCODE_WORKER_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-opencode-worker}"
mkdir -p "$LOG_DIR"
find "$LOG_DIR" -maxdepth 1 -type f -name '*.log' -mtime +7 -delete 2>/dev/null || true
LOG="$LOG_DIR/$RUN_STAMP.jsonl.log"
ERR_LOG="$LOG_DIR/$RUN_STAMP.stderr.log"
SUMMARY_DIR="$(mktemp -d "${TMPDIR:-/tmp}/opencode-worker.XXXXXX")"
trap 'rm -rf "$SUMMARY_DIR"' EXIT
READ_DIRS_MARKER="$SUMMARY_DIR/marker"
touch "$READ_DIRS_MARKER"

rc=0
if command -v timeout >/dev/null 2>&1; then
    timeout -k 15 "$TIMEOUT" opencode "${ARGS[@]}" "$PROMPT" > "$LOG" 2> "$ERR_LOG" || rc=$?
else
    opencode "${ARGS[@]}" "$PROMPT" > "$LOG" 2> "$ERR_LOG" || rc=$?
fi

if [[ "$MODE" == read ]]; then
    ANSWER_CHARS="${OPENCODE_WORKER_ANSWER_CHARS:-12000}"
else
    ANSWER_CHARS="${OPENCODE_WORKER_ANSWER_CHARS:-3000}"
fi

# Turns the JSON events into: OpenCode's final answer (capped), a one-line
# tool count, the failed tool calls, the denied ones, token usage and the
# session id. Lines that are not JSON events are kept apart for the plain
# text checks below.
summarize_events() {
    LOG="$LOG" OUT="$SUMMARY_DIR" ANSWER_CHARS="$ANSWER_CHARS" \
        VERBOSE="${OPENCODE_WORKER_VERBOSE:-}" python3 - <<'PYEOF'
import json, os
from collections import Counter

out = os.environ["OUT"]
limit = int(os.environ["ANSWER_CHARS"])
verbose = bool(os.environ["VERBOSE"])
events, plain = [], []
with open(os.environ["LOG"], encoding="utf-8", errors="replace") as f:
    for line in f:
        try:
            ev = json.loads(line)
            if not isinstance(ev, dict) or "type" not in ev:
                raise ValueError
            events.append(ev)
        except ValueError:
            plain.append(line)
with open(os.path.join(out, "plain"), "w") as f:
    f.writelines(plain)
if not events:
    raise SystemExit(0)

def short(value, n=160):
    text = " ".join(str(value).split())
    return text if len(text) <= n else text[: n - 3] + "..."

def tool_target(state):
    args = state.get("input") or {}
    for key in ("command", "filePath", "path", "pattern", "url"):
        if key in args:
            return short(args[key], 100)
    return ""

session, tools, failed, denied, transcript = "", Counter(), [], [], []
tokens = Counter()
last_tool_at, texts = -1, []
for i, ev in enumerate(events):
    session = session or ev.get("sessionID", "")
    part = ev.get("part") or {}
    if ev["type"] == "text":
        texts.append((i, part.get("text", "")))
        transcript.append(part.get("text", "").strip())
    elif ev["type"] == "tool_use":
        last_tool_at = i
        state = part.get("state") or {}
        name = part.get("tool", "?")
        tools[name] += 1
        transcript.append(f"[{name}] {tool_target(state)} ({state.get('status', '?')})")
        if state.get("status") == "error":
            err = str(state.get("error", ""))
            line = f"{name} {tool_target(state)}: {short(err)}"
            if "rule which prevents" in err or "auto-reject" in err:
                denied.append(line)
            else:
                failed.append(line)
    elif ev["type"] == "step_finish":
        t = part.get("tokens") or {}
        tokens["input"] += t.get("input", 0) or 0
        tokens["output"] += t.get("output", 0) or 0
        tokens["cache read"] += (t.get("cache") or {}).get("read", 0) or 0

final = [t for i, t in texts if i > last_tool_at] or [t for _, t in texts[-1:]]
answer = "\n".join(t.strip() for t in final if t.strip())
if len(answer) > limit:
    answer = answer[:limit] + f"\n[... answer cut at {limit} characters; full text in the log]"

lines = []
if verbose:
    lines += ["--- Transcript ---", *transcript, "--- End of transcript ---"]
lines += ["OpenCode answer:", answer or "(no text answer)"]
if tools:
    lines.append("Tools: " + ", ".join(f"{k} x{v}" for k, v in sorted(tools.items())))
if failed:
    lines.append(f"Failed tool calls ({len(failed)}):")
    lines += ["  " + l for l in failed[:10]]
if tokens:
    lines.append("OpenCode tokens: " + ", ".join(f"{k} {v}" for k, v in tokens.items()))
with open(os.path.join(out, "report"), "w") as f:
    f.write("\n".join(lines) + "\n")
with open(os.path.join(out, "denied"), "w") as f:
    f.write("\n".join(denied[:10]) + ("\n" if denied else ""))
with open(os.path.join(out, "session"), "w") as f:
    f.write(session)
PYEOF
}

echo
if command -v python3 >/dev/null 2>&1 && summarize_events 2>/dev/null; then
    if [[ -s "$SUMMARY_DIR/report" ]]; then
        cat "$SUMMARY_DIR/report"
    elif [[ -s "$SUMMARY_DIR/plain" ]]; then
        # No JSON events at all (an old OpenCode, or a crash before the run).
        echo "OpenCode output (last lines):"
        tail -n 40 "$SUMMARY_DIR/plain" | cut -c1-300
    fi
else
    # Without python3 the events cannot be parsed: show the tail only.
    echo "OpenCode output (last lines; python3 not available to summarize):"
    tail -n 40 "$LOG" | cut -c1-300
    cp "$LOG" "$SUMMARY_DIR/plain"
fi
if [[ $rc -ne 0 && -s "$ERR_LOG" ]]; then
    echo "OpenCode stderr (last lines):"
    tail -n 15 "$ERR_LOG" | cut -c1-300
fi
echo "Full log: $LOG"

# A new session is found again by its unique title, so a later review can
# resume it with OPENCODE_WORKER_SESSION.
find_session_by_title() {
    local sessions
    sessions="$(cd "$PROJECT_DIR" && timeout 20 opencode session list --format json -n 20 2>/dev/null)" || return 0
    RUN_TITLE="$RUN_TITLE" python3 -c '
import json, os, sys
try:
    for s in json.load(sys.stdin):
        if s.get("title") == os.environ["RUN_TITLE"]:
            print(s["id"])
            break
except Exception:
    pass
' <<< "$sessions" 2>/dev/null || true
}

if [[ -z "$SESSION" && -s "$SUMMARY_DIR/session" ]]; then
    SESSION="$(cat "$SUMMARY_DIR/session")"
fi
if [[ -z "$SESSION" ]] && command -v timeout >/dev/null 2>&1; then
    SESSION="$(find_session_by_title)"
fi

echo
echo "=== Worker changes ==="
if [[ -n "$BASELINE" ]]; then
    git -C "$PROJECT_DIR" --no-pager diff --stat "$BASELINE" || true
    echo "Review with: git diff $BASELINE"
else
    git -C "$PROJECT_DIR" --no-pager diff --stat || true
fi
UNTRACKED_AFTER="$(hash_untracked)"
NEW_UNTRACKED="$(LC_ALL=C comm -13 <(cut -d' ' -f2- <<< "$UNTRACKED_BEFORE" | LC_ALL=C sort) <(cut -d' ' -f2- <<< "$UNTRACKED_AFTER" | LC_ALL=C sort) | sed '/^$/d')"
CHANGED_UNTRACKED="$(LC_ALL=C comm -13 <(echo "$UNTRACKED_BEFORE") <(echo "$UNTRACKED_AFTER") | cut -d' ' -f2- | grep -vxF -f <(printf '%s\n' "$NEW_UNTRACKED") | sed '/^$/d' || true)"
if [[ -n "$NEW_UNTRACKED" ]]; then
    echo "New untracked files:"
    indent <<< "$NEW_UNTRACKED"
fi
if [[ -n "$CHANGED_UNTRACKED" ]]; then
    echo "Already-untracked files the worker changed (not in git diff):"
    indent <<< "$CHANGED_UNTRACKED"
fi

if [[ -n "$SESSION" ]]; then
    echo
    echo "Session: $SESSION"
    echo "Send a correction with: OPENCODE_WORKER_SESSION=$SESSION bash $(realpath "$0" 2>/dev/null || echo "$0") <<'TASK'"
fi

if [[ $rc -eq 124 ]]; then
    echo >&2
    echo "ERROR: OpenCode timed out after ${TIMEOUT}s. Changes may be partial." >&2
    exit 124
fi

# "auto-rejecting" comes from permissions set to ask; the other message comes
# from the deny rules above. Both leave the task possibly incomplete.
# The deny message is matched only at the start of a line (after colour codes),
# so file content that quotes it, e.g. in a printed diff, is not a hit.
COLOUR=$'(\033\\[[0-9;]*m)*'
REJECTED="$(cat "$SUMMARY_DIR/denied" 2>/dev/null || true)"
PLAIN_REJECTED="$(cat "$SUMMARY_DIR/plain" "$ERR_LOG" 2>/dev/null | grep -a -E "auto-rejecting|^${COLOUR}Error: ${COLOUR}The user has specified a rule which prevents you" | cut -c1-200 || true)"
REJECTED="$(printf '%s\n%s\n' "$REJECTED" "$PLAIN_REJECTED" | sed '/^$/d')"
if [[ -n "$REJECTED" ]]; then
    echo >&2
    echo "ERROR: OpenCode hit denied or auto-rejected permissions; the task may be incomplete:" >&2
    indent <<< "$REJECTED" >&2
    [[ $rc -eq 0 ]] && rc=3
fi

if [[ "$MODE" == read ]]; then
    TREE_CHANGED=""
    if [[ -n "$BASELINE" ]]; then
        git -C "$PROJECT_DIR" diff --quiet "$BASELINE" || TREE_CHANGED=1
    else
        git -C "$PROJECT_DIR" diff --quiet || TREE_CHANGED=1
    fi
    [[ "$UNTRACKED_BEFORE" == "$UNTRACKED_AFTER" ]] || TREE_CHANGED=1
    if [[ -n "$TREE_CHANGED" ]]; then
        echo >&2
        echo "ERROR: the read-only run changed the working tree; see Worker changes above." >&2
        rc=4
    fi
fi

for dir in "${READ_DIRS[@]}"; do
    CHANGED_OUTSIDE="$(find "$dir" -path '*/.git' -prune -o -type f -newer "$READ_DIRS_MARKER" -print 2>/dev/null | head -n 10)"
    if [[ -n "$CHANGED_OUTSIDE" ]]; then
        echo >&2
        echo "ERROR: files changed in a directory shared read-only ($dir):" >&2
        indent <<< "$CHANGED_OUTSIDE" >&2
        rc=5
    fi
done

exit "$rc"
